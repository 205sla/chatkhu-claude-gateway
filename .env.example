# 이 파일은 자동 로드되지 않습니다. 실제 키를 저장소에 넣지 마세요.
CHATKHU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
# CHATKHU_API_KEY= (비대화형 실행에서만 안전하게 환경으로 주입)
# CHATKHU_KEY_FILE=C:\Users\you\private\chatkhu.key
# CHATKHU_MODEL= (models가 반환한 정확한 ID)
# CHATKHU_CONFIG_DIR= (선택: 사용자 전용 설정 디렉터리)
# CHATKHU_CLAUDE_BIN= (선택: native 실행 파일 또는 검증된 npm CLI entrypoint)
# CHATKHU_PORT=0
# CHATKHU_CONNECT_TIMEOUT_MS=15000
# CHATKHU_IDLE_TIMEOUT_MS=120000
# CHATKHU_MAX_REQUEST_BYTES=25000000
# CHATKHU_LOCAL_TOKEN_FILE= (serve에서 선택: 32자 이상의 별도 로컬 토큰 파일)
